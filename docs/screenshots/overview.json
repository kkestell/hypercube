      "status": 200,
      "type": "text/plain",
      "body": "diff --git a/build.go b/build.go\nindex 8f92c3d..c21470a 100644\n--- a/build.go\n+++ b/build.go\n@@ -1,97 +1,133 @@\n package main\n \n import (\n \t\"bytes\"\n \t\"html/template\"\n \t\"io/fs\"\n \t\"os\"\n \t\"path/filepath\"\n \t\"strings\"\n \n \t\"github.com/yuin/goldmark\"\n )\n \n // Site is a folder of Markdown pages, the templates they render with, and\n // the folder the HTML goes to.\n type Site struct {\n \tContent   string\n \tTemplates string\n \tOut       string\n+\t// Force rebuilds every page, ignoring the build cache.\n+\tForce bool\n }\n \n // Page is one rendered page.\n type Page struct {\n \tTitle string\n \tBody  template.HTML\n }\n \n-// Build renders every page under Content into Out and returns how many it\n-// wrote.\n+// Build renders the pages under Content that changed since the last build\n+// into Out and returns how many it wrote.\n func (s Site) Build() (int, error) {\n \ttmpl, err := template.ParseGlob(filepath.Join(s.Templates, \"*.html\"))\n \tif err != nil {\n \t\treturn 0, err\n \t}\n-\tif err := os.RemoveAll(s.Out); err != nil {\n+\ttemplates, err := hashTemplates(s.Templates)\n+\tif err != nil {\n \t\treturn 0, err\n \t}\n+\tcachePath := filepath.Join(s.Out, cacheFile)\n+\tcache := buildCache{}\n+\tif !s.Force {\n+\t\tif cache, err = loadCache(cachePath); err != nil {\n+\t\t\treturn 0, err\n+\t\t}\n+\t}\n \tn := 0\n \terr = filepath.WalkDir(s.Content, func(path string, d fs.DirEntry, err error) error {\n \t\tif err != nil || d.IsDir() || filepath.Ext(path) != \".md\" {\n \t\t\treturn err\n \t\t}\n-\t\tif err := s.render(tmpl, path); err != nil {\n+\t\tsrc, err := os.ReadFile(path)\n+\t\tif err != nil {\n \t\t\treturn err\n \t\t}\n+\t\tk := key(src, templates)\n+\t\tif cache[path] == k {\n+\t\t\treturn nil\n+\t\t}\n+\t\tif err := s.render(tmpl, path, src); err != nil {\n+\t\t\treturn err\n+\t\t}\n+\t\tcache[path] = k\n \t\tn++\n \t\treturn nil\n \t})\n-\treturn n, err\n+\tif err != nil {\n+\t\treturn n, err\n+\t}\n+\treturn n, cache.save(cachePath)\n }\n \n-func (s Site) render(tmpl *template.Template, path string) error {\n-\tsrc, err := os.ReadFile(path)\n+// hashTemplates hashes every template, so a template change rebuilds every\n+// page.\n+func hashTemplates(dir string) (string, error) {\n+\tpaths, err := filepath.Glob(filepath.Join(dir, \"*.html\"))\n \tif err != nil {\n-\t\treturn err\n+\t\treturn \"\", err\n+\t}\n+\tvar all []byte\n+\tfor _, p := range paths {\n+\t\tb, err := os.ReadFile(p)\n+\t\tif err != nil {\n+\t\t\treturn \"\", err\n+\t\t}\n+\t\tall = append(all, b...)\n \t}\n+\treturn key(all, \"\"), nil\n+}\n+\n+func (s Site) render(tmpl *template.Template, path string, src []byte) error {\n \tmeta, body := frontMatter(src)\n \tvar html bytes.Buffer\n \tif err := goldmark.Convert(body, &html); err != nil {\n \t\treturn err\n \t}\n \trel, _ := filepath.Rel(s.Content, path)\n \tout := filepath.Join(s.Out, strings.TrimSuffix(rel, \".md\")+\".html\")\n \tif err := os.MkdirAll(filepath.Dir(out), 0o755); err != nil {\n \t\treturn err\n \t}\n \tf, err := os.Create(out)\n \tif err != nil {\n \t\treturn err\n \t}\n \tdefer f.Close()\n \tname := meta[\"template\"]\n \tif name == \"\" {\n \t\tname = \"page.html\"\n \t}\n \treturn tmpl.ExecuteTemplate(f, name, Page{Title: meta[\"title\"], Body: template.HTML(html.String())})\n }\n \n // frontMatter splits \"key: value\" lines between --- fences from the page's\n // body.\n func frontMatter(src []byte) (map[string]string, []byte) {\n \tmeta := map[string]string{}\n \trest, ok := bytes.CutPrefix(src, []byte(\"---\\n\"))\n \tif !ok {\n \t\treturn meta, src\n \t}\n \thead, body, ok := bytes.Cut(rest, []byte(\"\\n---\\n\"))\n \tif !ok {\n \t\treturn meta, src\n \t}\n \tfor _, line := range strings.Split(string(head), \"\\n\") {\n \t\tif k, v, ok := strings.Cut(line, \":\"); ok {\n \t\t\tmeta[strings.TrimSpace(k)] = strings.TrimSpace(v)\n \t\t}\n \t}\n \treturn meta, body\n }\n"
