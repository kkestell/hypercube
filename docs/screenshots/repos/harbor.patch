new file mode 100644
index 0000000..4e5745e
--- /dev/null
+++ b/cache.go
@@ -0,0 +1,46 @@
+package main
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io/fs"
+	"os"
+)
+
+// cacheFile records what each page was built from, so a build can skip pages
+// whose source and templates have not changed.
+const cacheFile = ".harbor-cache.json"
+
+// buildCache maps a page's source path to the hash of its source and the
+// templates it was rendered with.
+type buildCache map[string]string
+
+func loadCache(path string) (buildCache, error) {
+	data, err := os.ReadFile(path)
+	if errors.Is(err, fs.ErrNotExist) {
+		return buildCache{}, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	c := buildCache{}
+	return c, json.Unmarshal(data, &c)
+}
+
+func (c buildCache) save(path string) error {
+	data, err := json.MarshalIndent(c, "", "  ")
+	if err != nil {
+		return err
+	}
+	return os.WriteFile(path, data, 0o644)
+}
+
+// key is the hash of a page's source together with the templates' hash.
+func key(src []byte, templates string) string {
+	h := sha256.New()
+	h.Write(src)
+	h.Write([]byte(templates))
+	return hex.EncodeToString(h.Sum(nil))
+}
