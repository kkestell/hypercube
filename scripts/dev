#!/usr/bin/env bash
# Run this checkout's hypercube in an isolated dev session, serving its browser
# view on port 4281. The session has its own state, configuration, and scratch
# repository under $DEV, so it never touches the installed hypercube's
# workspaces.
#
#   scripts/dev [up]   build the server, serve the view, and watch sources
#                      until Ctrl-C
#   scripts/dev up --app
#                      also run the native app, with its own menu bar icon
#                      and window
#   scripts/dev stop   stop the app; the sessions stay marked running, so `up`
#                      resumes them
#   scripts/dev clean  stop it and delete everything it left
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
DEV=${HYPERCUBE_DEV_DIR:-$HOME/projects/hypercube-dev}
# With --app, the dev session runs as its own application, so its
# notifications and their clicks never reach the installed Hypercube. Otherwise
# it is only the server, built into bin/dev.
APP=$ROOT/bin/HypercubeDev.app
PORT=${HYPERCUBE_DEV_PORT:-4281}
REPO=$DEV/repo
CONFIG=$DEV/config/hypercube/config.json

# Run hypercube against the dev state and configuration, with only the
# environment a fresh terminal gives it. Agents started by the dev session must
# not inherit the environment of the agent running this script.
DEV_ENV=(env -i HOME="$HOME" USER="${USER:-$(id -un)}" PATH="$PATH" LANG="${LANG:-en_US.UTF-8}" TERM="${TERM:-xterm-256color}"
	XDG_STATE_HOME="$DEV/state" XDG_CONFIG_HOME="$DEV/config")

# Wait for the app to finish detaching or quitting before starting its replacement.
stop_app() {
	if [ -f "$DEV/ui.pid" ]; then
		pid=$(cat "$DEV/ui.pid")
		if ps -p "$pid" -o command= | grep -q 'hypercube ui'; then
			kill -"$1" "$pid" || true
			# A child of this script is reaped by wait; any other process is polled.
			wait "$pid" 2>/dev/null || true
			for _ in $(seq 200); do
				kill -0 "$pid" 2>/dev/null || break
				sleep 0.1
			done
			kill -9 "$pid" 2>/dev/null || true
		fi
		rm -f "$DEV/ui.pid"
	fi
}

restart() { stop_app TERM; }
quit() { stop_app INT; }

# A crashed dev app can leave holders behind. They belong to this dev state.
stop_holders() {
	local file pid
	local pids=()
	for file in "$DEV"/state/hypercube/run/*/pid; do
		[ -f "$file" ] || continue
		pid=$(cat "$file")
		case "$(ps -p "$pid" -o command=)" in
			*"hypercube hold "*) kill -TERM "$pid" 2>/dev/null || true; pids+=("$pid");;
		esac
	done
	[ "${#pids[@]}" -gt 0 ] || return 0
	for pid in "${pids[@]}"; do
		while kill -0 "$pid" 2>/dev/null; do sleep 0.1;	done
	done
}

case "${1:-up}" in
up)
	cd "$ROOT"
	case "${2:-}" in
		"") MENU= BIN=$ROOT/bin/dev/hypercube ;;
		--app) MENU=--menu BIN=$APP/Contents/MacOS/hypercube ;;
		*) echo "usage: scripts/dev up [--app]" >&2; exit 2 ;;
	esac
	restart
	trap quit EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM

	mkdir -p "$DEV/state" "$(dirname "$CONFIG")"
	if [ ! -d "$REPO/.git" ]; then
		mkdir -p "$REPO"
		git -C "$REPO" init -q -b main
	fi
	# Use real source files as sample content, keeping any local edits.
	for file in README.md docs/usage.md internal/ui/web/base.css internal/ui/web/sidebar/session-item.jsx internal/ui/web/sidebar/session-item.css; do
		if [ ! -e "$REPO/$file" ]; then
			mkdir -p "$(dirname "$REPO/$file")"
			cp "$ROOT/$file" "$REPO/$file"
		fi
	done
	if ! git -C "$REPO" rev-parse --verify HEAD >/dev/null 2>&1; then
		git -C "$REPO" add .
		git -C "$REPO" -c user.name=hypercube-dev -c user.email=dev@localhost \
			commit -q -m "Initial commit"
	fi
	if [ ! -f "$CONFIG" ]; then
		cat >"$CONFIG" <<'JSON'
{
  "profiles": [
    {
      "name": "claude",
      "description": "Claude Code haiku, for smoke tests.",
      "harness": "claude",
      "model": "haiku",
      "effort": "low"
    },
    {
      "name": "opencode",
      "description": "OpenCode with DeepSeek Flash, for smoke tests.",
      "harness": "opencode",
      "model": "openrouter/~deepseek/deepseek-flash-latest",
      "effort": "high"
    },
    {
      "name": "codex",
      "description": "Codex Luna, for smoke tests.",
      "harness": "codex",
      "model": "gpt-6-luna",
      "effort": "low"
    },
    {
      "name": "pi",
      "description": "Pi with DeepSeek Flash, for smoke tests.",
      "harness": "pi",
      "model": "openrouter/~deepseek/deepseek-flash-latest",
      "effort": "low"
    }
  ]
}
JSON
	fi

	# Poll source contents rather than mtimes, including additions and deletions.
	# The generated browser build and dependencies are excluded so builds do not
	# trigger builds.
	sources() {
		{
			find cmd internal plugins \( -type d -name node_modules -o -path internal/ui/dist \) -prune -o \
				-type f -exec cksum {} +
			cksum go.mod go.sum Makefile scripts/dev
		} | LC_ALL=C sort | cksum
	}
	build() {
		make ui || return 1
		if [ -n "$MENU" ]; then
			make bundle APP="$APP" APP_ID=com.github.kkestell.hypercube.dev APP_NAME="Hypercube Dev" &&
				/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$APP"
		else
			make binaries OUT="$ROOT/bin/dev"
		fi
	}
	start_view() {
		"${DEV_ENV[@]}" "$BIN" ui "$PORT" $MENU &
		view_pid=$!
		echo "$view_pid" >"$DEV/ui.pid"
		for _ in $(seq 50); do
			if ! kill -0 "$view_pid" 2>/dev/null; then
				wait "$view_pid"
				return 1
			fi
			if curl -fs --max-time 1 -o /dev/null "http://localhost:$PORT/" 2>/dev/null; then
				return
			fi
			sleep 0.1
		done
		echo "Dev view did not start on port $PORT" >&2
		return 1
	}
	revision=$(sources)
	build
	start_view
	echo "Dev repository: $REPO (config $CONFIG, view http://localhost:$PORT/)"
	echo "Watching sources; Ctrl-C stops the dev session."
	while kill -0 "$view_pid" 2>/dev/null; do
		sleep 1
		next=$(sources)
		if [ "$next" = "$revision" ]; then continue; fi
		revision=$next
		echo "Sources changed; rebuilding..."
		if build; then
			restart
			start_view
		else
			echo "Build failed; keeping the previous view. Waiting for changes." >&2
		fi
	done
	wait "$view_pid"
	;;
stop)
	quit
	;;
clean)
	quit
	stop_holders
	# OpenCode's conversations of the dev agents, with their subagents'.
	for conversation in $(sqlite3 "$DEV/state/hypercube/hypercube.db" \
		"SELECT conversation FROM sessions WHERE harness = 'opencode' AND conversation != ''" 2>/dev/null); do
		opencode session delete "$conversation" >/dev/null 2>&1 || true
	done
	[ -n "$DEV" ] && rm -rf "$DEV"
	# Claude Code's transcripts of the dev agents; the trust entry for the
	# scratch repository stays in ~/.claude.json.
	rm -rf "$HOME"/.claude/projects/"$(printf %s "$DEV" | sed 's/[^A-Za-z0-9]/-/g')"*
	;;
*)
	echo "usage: scripts/dev [up [--app] | stop | clean]" >&2
	exit 2
	;;
esac
