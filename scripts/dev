#!/usr/bin/env bash
# Run this checkout's hypercube in an isolated dev session, served by its own
# browser view on port 4281. The session has its own state, configuration, and
# scratch repository under $DEV, so it never touches the installed hypercube's
# workspaces. The scratch repository is the session's workspace.
#
#   scripts/dev [up]   build, serve the view, and watch sources until Ctrl-C
#   scripts/dev stop   stop the app; the sessions stay marked running, so `up`
#                      resumes them
#   scripts/dev clean  stop it and delete everything it left
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
DEV=${HYPERCUBE_DEV_DIR:-$HOME/projects/hypercube-dev}
BIN=$ROOT/bin/hypercube
PORT=${HYPERCUBE_DEV_PORT:-4281}
REPO=$DEV/repo
CONFIG=$DEV/config/hypercube/config.json

# Run hypercube against the dev state and configuration, with only the
# environment a fresh terminal gives it. Agents started by the dev session must
# not inherit the environment of the agent running this script.
DEV_ENV=(env -i HOME="$HOME" USER="${USER:-$(id -un)}" PATH="$PATH" LANG="${LANG:-en_US.UTF-8}" TERM="${TERM:-xterm-256color}"
	XDG_STATE_HOME="$DEV/state" XDG_CONFIG_HOME="$DEV/config")

# Stop the app through its own shutdown, which ends every agent's harness and
# the panel shells, and wait for it to finish. The sessions stay marked running.
stop() {
	if [ -f "$DEV/ui.pid" ]; then
		pid=$(cat "$DEV/ui.pid")
		if ps -p "$pid" -o command= | grep -q 'hypercube ui'; then
			kill "$pid" || true
			# A child of this script is reaped by wait; any other process is polled.
			wait "$pid" 2>/dev/null || true
			for _ in $(seq 200); do
				kill -0 "$pid" 2>/dev/null || break
				sleep 0.1
			done
			kill -9 "$pid" 2>/dev/null || true
		fi
		rm -f "$DEV/ui.pid"
	fi
}

case "${1:-up}" in
up)
	cd "$ROOT"
	stop
	trap stop EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM

	mkdir -p "$DEV/state" "$(dirname "$CONFIG")"
	if [ ! -d "$REPO/.git" ]; then
		mkdir -p "$REPO"
		git -C "$REPO" init -q -b main
		echo "# hypercube dev" >"$REPO/README.md"
		git -C "$REPO" add README.md
		git -C "$REPO" -c user.name=hypercube-dev -c user.email=dev@localhost \
			commit -q -m "Initial commit"
	fi
	if [ ! -f "$CONFIG" ]; then
		cat >"$CONFIG" <<'JSON'
{
  "profiles": [
    {
      "name": "claude-lead",
      "role": "lead",
      "description": "Claude Code haiku, for smoke tests.",
      "harness": "claude",
      "model": "haiku",
      "effort": "low"
    },
    {
      "name": "codex-lead",
      "role": "lead",
      "description": "Codex Luna, for smoke tests.",
      "harness": "codex",
      "model": "gpt-6-luna",
      "effort": "low"
    },
    {
      "name": "claude",
      "role": "work",
      "description": "Claude Code haiku, for smoke tests.",
      "harness": "claude",
      "model": "haiku",
      "effort": "low"
    },
    {
      "name": "opencode",
      "role": "work",
      "description": "OpenCode with DeepSeek Flash, for smoke tests.",
      "harness": "opencode",
      "model": "openrouter/~deepseek/deepseek-flash-latest",
      "effort": "high"
    },
    {
      "name": "codex",
      "role": "work",
      "description": "Codex Luna, for smoke tests.",
      "harness": "codex",
      "model": "gpt-6-luna",
      "effort": "low"
    },
    {
      "name": "pi",
      "role": "work",
      "description": "Pi with DeepSeek Flash, for smoke tests.",
      "harness": "pi",
      "model": "openrouter/~deepseek/deepseek-flash-latest",
      "effort": "low"
    }
  ]
}
JSON
	fi

	# Poll source contents rather than mtimes, including additions and deletions.
	# The generated browser build and dependencies are excluded so builds do not
	# trigger builds.
	sources() {
		{
			find cmd internal plugins \( -type d -name node_modules -o -path internal/ui/dist \) -prune -o \
				-type f -exec cksum {} +
			cksum go.mod go.sum Makefile scripts/dev
		} | LC_ALL=C sort | cksum
	}
	build() {
		make ui && make build
	}
	start_view() {
		"${DEV_ENV[@]}" "$BIN" ui "$PORT" &
		view_pid=$!
		echo "$view_pid" >"$DEV/ui.pid"
		for _ in $(seq 50); do
			if ! kill -0 "$view_pid" 2>/dev/null; then
				wait "$view_pid"
				return 1
			fi
			if curl -fs --max-time 1 -o /dev/null "http://localhost:$PORT/" 2>/dev/null; then
				# Adding a workspace that exists already changes nothing.
				curl -fs -o /dev/null -X POST -H "Origin: http://localhost:$PORT" \
					"http://localhost:$PORT/workspace?action=new&path=$REPO"
				return
			fi
			sleep 0.1
		done
		echo "Dev view did not start on port $PORT" >&2
		return 1
	}
	revision=$(sources)
	build
	start_view
	echo "Dev repository: $REPO (config $CONFIG, view http://localhost:$PORT/)"
	echo "Watching sources; Ctrl-C stops the dev app."
	while kill -0 "$view_pid" 2>/dev/null; do
		sleep 1
		next=$(sources)
		if [ "$next" = "$revision" ]; then continue; fi
		revision=$next
		echo "Sources changed; rebuilding..."
		if build; then
			stop
			start_view
		else
			echo "Build failed; keeping the previous view. Waiting for changes." >&2
		fi
	done
	wait "$view_pid"
	;;
stop)
	stop
	;;
clean)
	stop
	# OpenCode's conversations of the dev agents, with their subagents'.
	for conversation in $(sqlite3 "$DEV/state/hypercube/hypercube.db" \
		"SELECT conversation FROM agents WHERE harness = 'opencode' AND conversation != ''" 2>/dev/null); do
		opencode session delete "$conversation" >/dev/null 2>&1 || true
	done
	[ -n "$DEV" ] && rm -rf "$DEV"
	# Claude Code's transcripts of the dev agents; the trust entry for the
	# scratch repository stays in ~/.claude.json.
	rm -rf "$HOME"/.claude/projects/"$(printf %s "$DEV" | sed 's/[^A-Za-z0-9]/-/g')"*
	;;
*)
	echo "usage: scripts/dev [up | stop | clean]" >&2
	exit 2
	;;
esac
