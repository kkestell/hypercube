#!/usr/bin/env bash
# Run this checkout's hypercube in an isolated dev session, served by its own
# browser view on port 4281. The session has its own state, configuration, and
# scratch repository under $DEV, so it never touches the installed hypercube's
# workspaces.
#
#   scripts/dev [up]   build, restart the dev session and its view on the new
#                      binary, and open the view in the browser
#   scripts/dev stop   stop the view and every dev workspace; their state
#                      stays, so `up` resumes it
#   scripts/dev clean  stop it and delete everything it left
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
DEV=${HYPERCUBE_DEV_DIR:-$HOME/projects/hypercube-dev}
BIN=$ROOT/bin/hypercube
PORT=4281
REPO=$DEV/repo
CONFIG=$DEV/config/hypercube/config.json

# Run hypercube against the dev state and configuration, with only the
# environment a fresh terminal gives it. Agents started by the dev session must
# not inherit the environment of the agent running this script.
dev() {
	env -i HOME="$HOME" USER="${USER:-$(id -un)}" PATH="$PATH" LANG="${LANG:-en_US.UTF-8}" TERM="${TERM:-xterm-256color}" \
		TMUX_TMPDIR="$DEV" XDG_STATE_HOME="$DEV/state" XDG_CONFIG_HOME="$DEV/config" "$BIN" "$@"
}

# Stop the dev view and every workspace in the dev state.
stop() {
	if [ -f "$DEV/ui.pid" ]; then
		pid=$(cat "$DEV/ui.pid")
		if ps -p "$pid" -o command= | grep -q 'hypercube ui'; then
			kill "$pid" || true
		fi
		rm -f "$DEV/ui.pid"
	fi
	[ -x "$BIN" ] && [ -d "$DEV/state" ] || return 0
	echo y | dev stop --all >/dev/null 2>&1 || true
}

case "${1:-up}" in
up)
	cd "$ROOT"
	make build
	stop

	mkdir -p "$DEV/state" "$(dirname "$CONFIG")"
	if [ ! -d "$REPO/.git" ]; then
		mkdir -p "$REPO"
		git -C "$REPO" init -q -b main
		echo "# hypercube dev" >"$REPO/README.md"
		git -C "$REPO" add README.md
		git -C "$REPO" -c user.name=hypercube-dev -c user.email=dev@localhost \
			commit -q -m "Initial commit"
	fi
	if [ ! -f "$CONFIG" ]; then
		cat >"$CONFIG" <<'JSON'
{
  "lead": { "harness": "claude", "model": "haiku", "effort": "low" },
  "profiles": [
    {
      "name": "claude",
      "description": "Claude Code haiku, for smoke tests.",
      "harness": "claude",
      "model": "haiku",
      "effort": "low"
    },
    {
      "name": "opencode",
      "description": "OpenCode with DeepSeek Flash, for smoke tests.",
      "harness": "opencode",
      "model": "openrouter/~deepseek/deepseek-flash-latest",
      "effort": "high"
    },
    {
      "name": "codex",
      "description": "Codex Luna, for smoke tests.",
      "harness": "codex",
      "model": "gpt-6-luna",
      "effort": "low"
    },
    {
      "name": "pi",
      "description": "Pi with DeepSeek Flash, for smoke tests.",
      "harness": "pi",
      "model": "openrouter/~deepseek/deepseek-flash-latest",
      "effort": "low"
    }
  ]
}
JSON
	fi

	dev start "$REPO"
	# The view ignores a hangup so it outlives the shell that started it.
	(
		trap '' HUP
		dev ui "$PORT" >"$DEV/ui.log" 2>&1 </dev/null &
		echo $! >"$DEV/ui.pid"
	)
	for _ in $(seq 25); do
		curl -fs -o /dev/null "http://localhost:$PORT/" && break
		sleep 0.2
	done
	open "http://localhost:$PORT/"
	echo "Dev session: $REPO (config $CONFIG, view http://localhost:$PORT/)"
	;;
stop)
	stop
	;;
clean)
	stop
	# OpenCode's sessions of the dev agents, with their subagents' sessions.
	for session in $(cat "$DEV"/state/hypercube/*.json 2>/dev/null |
		grep -o '"session_id": *"ses_[^"]*"' | sed 's/.*"\(ses_[^"]*\)"$/\1/'); do
		opencode session delete "$session" >/dev/null 2>&1 || true
	done
	[ -n "$DEV" ] && rm -rf "$DEV"
	# Claude Code's transcripts of the dev agents; the trust entry for the
	# scratch repository stays in ~/.claude.json.
	rm -rf "$HOME"/.claude/projects/"$(printf %s "$DEV" | sed 's/[^A-Za-z0-9]/-/g')"*
	;;
*)
	echo "usage: scripts/dev [up | stop | clean]" >&2
	exit 2
	;;
esac
