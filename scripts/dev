#!/usr/bin/env bash
# Run this checkout's hypercube in an isolated dev session in a new Ghostty
# window. The session has its own state, configuration, and scratch repository
# under $DEV, so it never touches the installed hypercube's workspaces.
#
#   scripts/dev [up]   build, restart the dev session on the new binary, and
#                      open it in a Ghostty window
#   scripts/dev stop   stop every dev workspace; their state stays, so `up`
#                      resumes it
#   scripts/dev clean  stop it and delete everything it left
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
DEV=${HYPERCUBE_DEV_DIR:-$HOME/projects/hypercube-dev}
BIN=$ROOT/bin/hypercube
REPO=$DEV/repo
CONFIG=$DEV/config/hypercube/config.json

# Run hypercube against the dev state and configuration.
dev() {
	TMUX_TMPDIR=$DEV XDG_STATE_HOME=$DEV/state XDG_CONFIG_HOME=$DEV/config "$BIN" "$@"
}

# Stop every workspace in the dev state.
stop() {
	[ -x "$BIN" ] && [ -d "$DEV/state" ] || return 0
	echo y | dev stop --all >/dev/null 2>&1 || true
}

case "${1:-up}" in
up)
	cd "$ROOT"
	go build -o "$BIN" ./cmd/hypercube
	stop

	mkdir -p "$DEV/state" "$(dirname "$CONFIG")"
	if [ ! -d "$REPO/.git" ]; then
		mkdir -p "$REPO"
		git -C "$REPO" init -q -b main
		echo "# hypercube dev" >"$REPO/README.md"
		git -C "$REPO" add README.md
		git -C "$REPO" -c user.name=hypercube-dev -c user.email=dev@localhost \
			commit -q -m "Initial commit"
	fi
	if [ ! -f "$CONFIG" ]; then
		cat >"$CONFIG" <<'JSON'
{
  "orchestrator": { "harness": "claude", "model": "haiku", "effort": "low" },
  "profiles": [
    {
      "name": "claude",
      "description": "Claude Code haiku, for smoke tests.",
      "harness": "claude",
      "model": "haiku",
      "effort": "low"
    },
    {
      "name": "opencode",
      "description": "OpenCode with DeepSeek Flash, for smoke tests.",
      "harness": "opencode",
      "model": "openrouter/~deepseek/deepseek-flash-latest",
      "effort": "high"
    }
  ]
}
JSON
	fi

	# Ghostty starts the command without this shell's environment.
	cat >"$DEV/run" <<RUN
#!/bin/sh
export PATH='$PATH'
export TMUX_TMPDIR='$DEV'
export XDG_STATE_HOME='$DEV/state' XDG_CONFIG_HOME='$DEV/config'
unset TMUX TMUX_PANE
# Claude Code saves no transcripts with the marker its own shells carry, so
# dev agents started from inside Claude Code could not resume.
unset CLAUDE_CODE_CHILD_SESSION
cd '$REPO'
'$BIN' || { echo "hypercube exited with \$?; press Enter to close"; read -r _; }
RUN
	chmod +x "$DEV/run"
	open -na Ghostty --args --quit-after-last-window-closed=true -e "$DEV/run"
	echo "Dev session: $REPO (config $CONFIG)"
	;;
stop)
	stop
	;;
clean)
	stop
	# OpenCode's sessions of the dev agents, with their subagents' sessions.
	for session in $(cat "$DEV"/state/hypercube/*.json 2>/dev/null |
		grep -o '"session_id": *"ses_[^"]*"' | sed 's/.*"\(ses_[^"]*\)"$/\1/'); do
		opencode session delete "$session" >/dev/null 2>&1 || true
	done
	[ -n "$DEV" ] && rm -rf "$DEV"
	# Claude Code's transcripts of the dev agents; the trust entry for the
	# scratch repository stays in ~/.claude.json.
	rm -rf "$HOME"/.claude/projects/"$(printf %s "$DEV" | sed 's/[^A-Za-z0-9]/-/g')"*
	;;
*)
	echo "usage: scripts/dev [up | stop | clean]" >&2
	exit 2
	;;
esac
