#!/bin/sh
# Remove what `make install` and `make install-service` add: the service, the
# bundle, the links in BINDIR that point into it, the launcher entry, the icon,
# and the AppArmor profile, which takes one sudo command. Running agents and
# shells end with the backend, and a running desktop app quits. Configuration
# and saved state stay. It ships in the bundle as resources/uninstall and is run
# by `make uninstall`. BINDIR defaults to ~/.local/bin.
set -eu

data=${XDG_DATA_HOME:-$HOME/.local/share}
app=$data/hypercube
bin=${BINDIR:-$HOME/.local/bin}
id=com.github.kkestell.hypercube
unit=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$id.service
profile=/etc/apparmor.d/$id

# quit_desktop quits the desktop app running from the installed bundle with
# SIGTERM, Electron's normal quit, which saves the window's position. It skips
# Chromium's child processes, which have a --type argument, and fails if the app
# is still running after ten seconds.
quit_desktop() {
	dir=$(cd "$app" 2>/dev/null && pwd -P) || return 0
	for proc in /proc/[0-9]*; do
		[ "$(readlink "$proc/exe" 2>/dev/null)" = "$dir/hypercube-desktop" ] || continue
		if grep -qa -e '--type=' "$proc/cmdline" 2>/dev/null; then continue; fi
		pid=${proc#/proc/}
		kill "$pid" 2>/dev/null || continue
		for _ in $(seq 100); do
			kill -0 "$pid" 2>/dev/null || continue 2
			sleep 0.1
		done
		echo "uninstall: the desktop app (process $pid) did not quit" >&2
		exit 1
	done
}

# SIGINT makes the backend end its agents and shells, since no backend will
# adopt them. stop then waits for the backend to exit; its SIGTERM arrives after
# the SIGINT and does not change the shutdown.
if [ -e "$unit" ]; then
	if systemctl --user is-active --quiet "$id"; then
		systemctl --user kill --kill-whom=main --signal=SIGINT "$id"
	fi
	systemctl --user stop "$id"
	systemctl --user disable "$id"
	rm -f "$unit"
	systemctl --user daemon-reload
fi

for link in "$bin/hypercube" "$bin"/hypercube-harness-*; do
	case $(readlink "$link" 2>/dev/null) in
	"$app"/*) rm -f "$link" ;;
	esac
done
rm -f "$data/applications/$id.desktop" "$data/icons/hicolor/512x512/apps/$id.png"
if [ -f "$app/hypercube-desktop" ] && [ -f "$app/resources/uninstall" ]; then
	quit_desktop
	rm -rf "$app"
	echo "removed $app"
elif [ -e "$app" ]; then
	echo "uninstall: $app is not a Hypercube bundle; leaving it" >&2
fi

if [ -e "$profile" ]; then
	sudo sh -c 'apparmor_parser -R "$1"; rm -f "$1"' sh "$profile"
fi
