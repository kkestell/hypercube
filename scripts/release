#!/bin/bash
# Package a clean, tagged beta for the machine it runs on without touching the
# installed app.
set -euo pipefail
cd "$(dirname "$0")/.."

tag=${1:-$(git describe --tags --exact-match --match 'v[0-9]*' HEAD)}
if [[ ! "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+-beta\.[1-9][0-9]*$ ]]; then
	echo "release: expected a beta tag such as v0.1.0-beta.1" >&2
	exit 1
fi
commit=$(git rev-parse HEAD)
if [ "$(git rev-parse "$tag^{commit}")" != "$commit" ]; then
	echo "release: $tag does not identify HEAD" >&2
	exit 1
fi
if [ -n "$(git status --porcelain)" ]; then
	echo "release: commit or remove checkout changes before packaging" >&2
	exit 1
fi

check_identity() {
	identity=$("$1" version)
	if [ "$identity" != "Hypercube $tag ($commit)" ]; then
		echo "release: unexpected build identity: $identity" >&2
		exit 1
	fi
}

package_macos() {
	if [ "$(go env GOARCH)" != arm64 ]; then
		echo "release: build on Apple Silicon (darwin/arm64)" >&2
		exit 1
	fi
	make bundle APP=bin/release/Hypercube.app SIGN_IDENTITY=-
	app=bin/release/Hypercube.app
	check_identity "$app/Contents/MacOS/hypercube"
	codesign --verify --deep --strict "$app"
	archive=Hypercube-$tag-macos-arm64.zip
	ditto -c -k --sequesterRsrc --keepParent "$app" "bin/release/$archive"
}

package_linux() {
	make bundle APP=bin/release/Hypercube
	check_identity bin/release/Hypercube/hypercube
	archive=Hypercube-$tag-linux-$(go env GOARCH).tar.gz
	tar -C bin/release -czf "bin/release/$archive" Hypercube
}

rm -rf bin/release
case "$(go env GOOS)" in
darwin) package_macos ;;
linux) package_linux ;;
*)
	echo "release: build on macOS or Linux" >&2
	exit 1
	;;
esac
cd bin/release
if command -v sha256sum >/dev/null; then
	sha256sum "$archive" > SHA256SUMS
else
	shasum -a 256 "$archive" > SHA256SUMS
fi
echo "Packaged $identity: bin/release/$archive"
